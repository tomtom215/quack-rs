# SPDX-License-Identifier: MIT
# https://editorconfig.org -- the whitespace rules the repository already follows
# (`.gitattributes` fixes LF; no tracked .rs/.toml/.md/.yml/.py/.sh file lacks a
# final newline or has trailing whitespace in Rust), written down so an editor
# without rustfmt on save does not drift.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.sh]
indent_size = 2

# Markdown keeps trailing double-space line breaks and mixed list indents.
[*.md]
trim_trailing_whitespace = false
indent_size = unset

# Makefiles (and the Makefile text generated by the scaffold) need tabs.
[{Makefile,*.mk}]
indent_style = tab

[*.{png,bin}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Fuzz seeds must reach the fuzzer byte for byte (.gitattributes: binary).
[fuzz/seeds/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
